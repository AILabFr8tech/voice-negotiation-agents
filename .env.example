# Plantilla de variables de entorno. Copiar a `.env` en la raíz del repo
# (`.env` está gitignored) y rellenar. Este archivo NO debe contener valores
# reales nunca.

# --- Confirmadas ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=

# Modelo del LLM como variable de config, no hardcodeado: cambiar de modelo
# debe ser un cambio de valor aquí, nunca una reescritura del system prompt.
# Fijado en gpt-4.1-mini el 3 de agosto de 2026 para las PoC de pipeline (1 y 2):
# el LLM domina la latencia del turno y este modelo baja el TTFT sin salir del
# ecosistema OpenAI. No cambiarlo a media campaña de llamadas: rompe la
# comparabilidad entre PoC.
OPENAI_MODEL=gpt-4.1-mini

# --- GPT-Live (PoC3) ---
# PoC3 reemplaza al slot de OpenAI Realtime API. Reusa OPENAI_API_KEY de arriba
# y NO necesita DEEPGRAM_API_KEY ni ELEVEN_API_KEY: el modelo es full-duplex y
# trae STT y TTS nativos.
#
# Slug del modelo full-duplex. Variable propia, NO reusa OPENAI_MODEL: esa
# describe el LLM del pipeline (gpt-4.1-mini), y en PoC3 no hay pipeline.
# Desde el 30 de septiembre de 2026 el puente habla el protocolo público
# (wss://api.openai.com/v1/live/sessions); el `-boulder-alpha` ya no existe.
OPENAI_LIVE_MODEL=gpt-live-1

# OPENAI_LIVE_ALPHA_HEADER ya no se lee: el acceso al protocolo del alpha se
# retiró (`quicksilver_v2_access_denied`). Si está en tu .env, no estorba.

# Voz nativa del modelo. El alpha documenta `marin` como default y no publica
# catálogo. PoC1 y PoC2 corren la misma voz de ElevenLabs y PoC3 no puede: es
# una asimetría declarada en docs/CONTRATO_METRICAS.md §2.4, no un descuido.
OPENAI_LIVE_VOICE=marin

# OJO: OPENAI_MODEL (arriba) SÍ aplica a PoC3, pero para otra cosa — es el
# modelo al que GPT-Live delega el tool calling (`delegation.responses.model`).
# Tiene que seguir siendo el mismo que PoC1 y PoC2 o la comparación del tool
# calling mediría el modelo. Se factura aparte de la sesión de voz de
# `gpt-live-1` (docs/costos_poc3.md).

# --- Modelos de voz (opcionales: si se omiten, se usan estos defaults) ---
# nova-3 + language=multi es lo que habilita el cambio es->en que pide el
# system prompt. El bake-off puede cambiar estos valores sin tocar código.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# eleven_flash_v2_5, NO eleven_flash_v2: el v2 es solo inglés.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Voz de ElevenLabs para el agente. Obligatoria en cuanto haya TTS real.
# La campaña de latencia corrió con esta voz ("Alexander", de la biblioteca: por
# API exige plan de pago). La de interrupciones corrió con la voz predeterminada
# "Roger" (CwhRBWXzGAHq8TQ4Fs17), que funciona en el plan gratuito.
ELEVENLABS_VOICE_ID=7uSWXMmzGnsyxZwYFfmK

# --- Twilio (PoC1 y PoC3 completo; PoC2 solo reusa TWILIO_NUMERO_DESTINO) ---
# PoC3 usa exactamente la misma capa de telefonía que PoC1 —Media Streams sobre
# WebSocket, mismo número, mismo destino— a propósito: así la comparación mide
# el motor conversacional y no el bus de medios.
# Estado: se está usando la cuenta existente del agente despachador, SOLO para
# llamadas salientes. Una llamada saliente lleva su propia `url` de TwiML por
# llamada, así que NO modifica el webhook configurado en el número — y este
# código nunca toca la configuración del número. Sigue pendiente la subcuenta
# dedicada para SPOTS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número que aparece como origen de la llamada (hoy: el del despachador).
TWILIO_PHONE_NUMBER=
# Número al que se marca por default si el endpoint no recibe uno explícito.
TWILIO_NUMERO_DESTINO=

# Dominio público fijo del túnel (ngrok), con o sin esquema. De aquí se arman
# el webhook de TwiML (https://...) y el Media Stream del bot (wss://...).
PUBLIC_URL=

# --- LiveKit + trunk SIP (PoC2) ---
# Proyecto de LiveKit. OJO: es el proyecto del agente despachador real, que está
# en uso. PoC2 corre aislado dentro de él (ver poc2_livekit/README.md).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Trunk SIP SALIENTE. Se referencia por id al crear el participante SIP; su
# configuración NUNCA se modifica desde este repo (tampoco para activar grabación).
SIP_OUTBOUND_TRUNK_ID=

# Nombre con el que se registra el worker de PoC2. Es el mecanismo de aislamiento,
# no una etiqueta: un worker con `agent_name` solo entra a las salas donde se le
# pide por nombre, así que ningún job del despachador puede aterrizar en él.
#
# TIENE que ser distinto de AGENT_NAME (la del despachador). `app/config.py`
# revienta si coinciden, y nunca lee AGENT_NAME como respaldo.
LIVEKIT_AGENT_NAME=spots-poc2-negociador

# AGENT_NAME pertenece al agente despachador. No la usa ninguna PoC de este repo.

# Versión del audio turn detector: v1 (modelo completo, corre REMOTO en LiveKit
# Inference) o v1-mini (ligero, corre local en CPU).
#
# Se fija a propósito: sin este valor, LiveKit elige según cómo se lanzó el
# worker (`dev` daría v1, `start` daría v1-mini), y la arquitectura que se mide
# no puede depender de eso.
#
# v1-mini porque PoC2 corre TODO en local: el worker se lanza desde la terminal
# y nada está desplegado en LiveKit Cloud. Así el detector queda local contra el
# Smart Turn v3 en proceso de PoC1, sin un salto de red que el resto de la
# arquitectura no tiene. No cambiarlo a media campaña de llamadas.
LIVEKIT_TURN_DETECTOR_VERSION=v1-mini

# PoC2 NO graba audio, así que no hay variables de Egress ni de almacenamiento.
# El WER se calcula contra el guion: las líneas `stt:` del JSON de cada llamada
# son la hipótesis, y la referencia sale del clip que reprodujo el arnés
# (docs/CONTRATO_METRICAS.md §2.10).
